FROM ran-base:latest AS ran-build-csi
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

# Step 1: Build libcsi_logging.a
RUN cd /tmp && \
    git clone https://github.com/turletti/oai-csi-logging.git && \
    cd oai-csi-logging && \
    mkdir -p build && cd build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    make && \
    make install && \
    ldconfig && \
    echo "✅ libcsi_logging.a built and installed"

RUN rm -Rf /oai-ran
WORKDIR /oai-ran
COPY . .

# Step 2: Apply CSI patches
RUN bash ./patch_csi_rx.sh && \
    bash ./patch_srs_ul.sh && \
    bash ./patch_nr_softmodem_main.sh && \
    echo "✅ All CSI patches applied"

# Step 3: Add csi_linking.cmake and apply it
RUN bash ./apply_csi_cmake.sh /oai-ran && \
    echo "✅ CMake configuration updated"

# Step 4: Build OAI with CSI
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y gcc-toolset-13 gcc-toolset-13-gcc-c++ gcc-toolset-13-binutils && \
    /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    source /opt/rh/gcc-toolset-13/enable && \
    CXXFLAGS='-Werror=format -fstack-protector-strong' \
    CFLAGS='-Werror=format -fstack-protector-strong' \
    ./build_oai -c --ninja \
      --eNB --gNB --RU --UE --nrUE \
      --build-e2 --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
      --cmake-opt -DKPM_VERSION=$KPM_VERSION \
      --cmake-opt '-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --cmake-opt '-DCMAKE_EXE_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --build-lib 'telnetsrv enbscope uescope nrscope' \
      --build-tool-opt -k10 -w USRP -t Ethernet --noavx512 && \
    echo "✅ OAI build SUCCESSFUL"

# Step 5: Build FlexRIC
RUN mkdir -p /oai-ran/openair2/E2AP/flexric/build && \
    cd /oai-ran/openair2/E2AP/flexric/build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
          -DKPM_VERSION=$KPM_VERSION \
          -DE2AP_VERSION=$E2AP_VERSION .. && \
    ninja && \
    ninja install