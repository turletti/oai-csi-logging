#---------------------------------------------------------------------
#
# Dockerfile for the Open-Air-Interface BUILD service with CSI LOGGING
#   Valid for Rocky 9
#
#---------------------------------------------------------------------

FROM ran-base:latest AS ran-build-csi
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

# STEP 1: Build CSI logging library as STATIC
RUN cd /tmp && \
    git clone https://github.com/turletti/oai-csi-logging.git && \
    cd oai-csi-logging && \
    sed -i '/^#endif/i /* Public API for pushing CSI measurements */\nint csi_logging_push_measurement(uint32_t frame, uint32_t slot, uint32_t rb, const void *h_data, uint32_t num_subcarriers);' include/csi_rb_logging_external.h && \
    sed -i 's/^static int csi_logging_push_measurement/int csi_logging_push_measurement/' src/csi_logging_callback.c && \
    sed -i 's/add_library(csi_logging SHARED/add_library(csi_logging STATIC/' CMakeLists.txt && \
    mkdir -p build && cd build && \
    source /opt/rh/gcc-toolset-13/enable && \
    CFLAGS='-Wl,-z,noexecstack -fPIC -Wall -Wextra' \
    CXXFLAGS='-Wl,-z,noexecstack -fPIC -Wall -Wextra' \
    cmake .. && make && make install && ldconfig && \
    cp /tmp/oai-csi-logging/include/*.h /usr/include/ && \
    echo "✅ libcsi_logging STATIC library built and installed"

# STEP 2: Prepare OAI source
RUN rm -Rf /oai-ran
WORKDIR /oai-ran
COPY . .

# STEP 3: Copy csi_integration.c to both required locations
RUN cp csi_integration.c openair1/PHY/NR_ESTIMATION/ && \
    cp csi_integration.c openair1/PHY/NR_UE_TRANSPORT/ && \
    echo "✅ csi_integration.c copied to NR_ESTIMATION and NR_UE_TRANSPORT"

# STEP 4: Apply CSI patches using robust awk (no line numbers)
RUN chmod +x patch_csi_rx.sh patch_srs_ul.sh && \
    bash patch_csi_rx.sh && \
    bash patch_srs_ul.sh && \
    echo "✅ CSI patches applied to csi_rx.c and nr_ul_channel_estimation.c"

# STEP 5: Add csi_integration.c to CMakeLists.txt using robust awk
# Add after nr_ul_channel_estimation.c
RUN awk '/\$\{OPENAIR1_DIR\}\/PHY\/NR_ESTIMATION\/nr_ul_channel_estimation\.c/ && !done_ul {print; print "  ${OPENAIR1_DIR}/PHY/NR_ESTIMATION/csi_integration.c"; done_ul=1; next} 1' CMakeLists.txt > CMakeLists.txt.tmp && mv CMakeLists.txt.tmp CMakeLists.txt && \
    echo "✅ Added csi_integration.c to NR_ESTIMATION section"

# Add after csi_rx.c
RUN awk '/\$\{OPENAIR1_DIR\}\/PHY\/NR_UE_TRANSPORT\/csi_rx\.c/ && !done_ue {print; print "  ${OPENAIR1_DIR}/PHY/NR_UE_TRANSPORT/csi_integration.c"; done_ue=1; next} 1' CMakeLists.txt > CMakeLists.txt.tmp && mv CMakeLists.txt.tmp CMakeLists.txt && \
    echo "✅ Added csi_integration.c to NR_UE_TRANSPORT section"

# STEP 6: Link csi_logging to nr-softmodem and nr-uesoftmodem using robust awk
RUN awk '/target_link_libraries\(nr-softmodem PRIVATE/ {in_target=1} in_target && /-Wl,--end-group/ && !done_soft {print "  csi_logging"; done_soft=1} {print}' CMakeLists.txt > CMakeLists.txt.tmp && mv CMakeLists.txt.tmp CMakeLists.txt && \
    echo "✅ Linked csi_logging to nr-softmodem"

RUN awk '/target_link_libraries\(nr-uesoftmodem PRIVATE/ {in_target=1} in_target && /-Wl,--end-group/ && !done_ue {print "  csi_logging"; done_ue=1} {print}' CMakeLists.txt > CMakeLists.txt.tmp && mv CMakeLists.txt.tmp CMakeLists.txt && \
    echo "✅ Linked csi_logging to nr-uesoftmodem"
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y gcc-toolset-13 gcc-toolset-13-gcc-c++ gcc-toolset-13-binutils && \
    /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    source /opt/rh/gcc-toolset-13/enable && \
    CXXFLAGS='-Werror=format -fstack-protector-strong' \
    CFLAGS='-Werror=format -fstack-protector-strong' \
    ./build_oai -c --ninja \
      --eNB --gNB --RU --UE --nrUE \
      --build-e2 --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
      --cmake-opt -DKPM_VERSION=$KPM_VERSION \
      --cmake-opt '-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --cmake-opt '-DCMAKE_EXE_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --build-lib 'telnetsrv enbscope uescope nrscope' \
      --build-tool-opt -k10 -w USRP -t Ethernet --noavx512 && \
    echo "✅ OAI build with CSI SUCCESSFUL"

# STEP 9: Build FlexRIC for SM Models
RUN mkdir -p openair2/E2AP/flexric/build && \
    cd openair2/E2AP/flexric/build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
          -DKPM_VERSION=$KPM_VERSION \
          -DE2AP_VERSION=$E2AP_VERSION .. && \
    ninja && \
    ninja install && \
    echo "✅ FlexRIC build SUCCESSFUL"