#---------------------------------------------------------------------
#
# Dockerfile for the Open-Air-Interface BUILD service with CSI LOGGING
#   Valid for Rocky 9
#
#---------------------------------------------------------------------

# STAGE 1: Build libcsi_logging and prepare CSI files
FROM ran-base:latest AS csi-builder
RUN cd /tmp && \
    git clone https://github.com/turletti/oai-csi-logging.git && \
    cd oai-csi-logging && \
    mkdir -p build && cd build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake .. && make && make install && ldconfig && \
    echo "✅ libcsi_logging built and installed"

# STAGE 2: Build OAI with CSI integration
FROM ran-base:latest AS ran-build-csi
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

# Copy CSI library from stage 1
COPY --from=csi-builder /usr/local/lib/libcsi_logging.a /usr/local/lib/
COPY --from=csi-builder /usr/local/include/csi*.h /usr/local/include/

# Copy OAI source
RUN rm -Rf /oai-ran
WORKDIR /oai-ran
COPY . .

# Copy CSI integration files from stage 1 
COPY --from=csi-builder /tmp/oai-csi-logging/docker/patch-scripts/csi_integration.c /tmp/
COPY --from=csi-builder /tmp/oai-csi-logging/docker/patch-scripts/patch_csi_rx.sh /tmp/
COPY --from=csi-builder /tmp/oai-csi-logging/docker/patch-scripts/patch_srs_ul.sh /tmp/

# Place csi_integration.c where it will be compiled
RUN cp /tmp/csi_integration.c openair1/PHY/NR_UE_TRANSPORT/ && \
    echo "✅ Copied csi_integration.c to NR_UE_TRANSPORT"

# Apply CSI patches
RUN chmod +x /tmp/patch_csi_rx.sh /tmp/patch_srs_ul.sh && \
    /tmp/patch_csi_rx.sh && \
    /tmp/patch_srs_ul.sh && \
    echo "✅ CSI patches applied"

# Add csi_integration.c to CMakeLists.txt for compilation
RUN sed -i '/src\/csi_rx\.c/a \  ${OPENAIR1_DIR}/PHY/NR_UE_TRANSPORT/csi_integration.c' CMakeLists.txt && \
    echo "✅ Added csi_integration.c to CMakeLists.txt"

# Link libcsi_logging
RUN sed -i 's/target_link_libraries(nr-softmodem PRIVATE/target_link_libraries(nr-softmodem PRIVATE csi_logging/' CMakeLists.txt && \
    sed -i 's/target_link_libraries(nr-uesoftmodem PRIVATE/target_link_libraries(nr-uesoftmodem PRIVATE csi_logging/' CMakeLists.txt && \
    echo "✅ Linked csi_logging to executables"

# Build OAI
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y \
        gcc-toolset-13 \
        gcc-toolset-13-gcc-c++ \
        gcc-toolset-13-binutils && \
    /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    source /opt/rh/gcc-toolset-13/enable && \
    CXXFLAGS='-Werror=format -fstack-protector-strong' \
    CFLAGS='-Werror=format -fstack-protector-strong' \
    ./build_oai -c --ninja \
      --eNB --gNB --RU --UE --nrUE \
      --build-e2 --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
      --cmake-opt -DKPM_VERSION=$KPM_VERSION \
      --cmake-opt '-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --cmake-opt '-DCMAKE_EXE_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --build-lib 'telnetsrv enbscope uescope nrscope' \
      --build-tool-opt -k10 -w USRP -t Ethernet --noavx512 && \
    echo "✅ OAI build with CSI SUCCESSFUL"

# Build FlexRIC
RUN mkdir -p openair2/E2AP/flexric/build && \
    cd openair2/E2AP/flexric/build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
          -DKPM_VERSION=$KPM_VERSION \
          -DE2AP_VERSION=$E2AP_VERSION .. && \
    ninja && \
    ninja install