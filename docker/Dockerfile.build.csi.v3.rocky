#
# Dockerfile for the Open-Air-Interface BUILD service with CSI v3 LOGGING
#   Valid for Rocky 9
#   Methodology: Inspired from V2 (proven to work)
#   - Minimize OAI modifications
#   - Use patch scripts (sed/awk) with verification
#   - Explicit linking
#   - All sources copied together (no split)

# STAGE 1: Build libcsi_logging_v3 library (self-contained)
FROM ran-base:latest AS csi-v3-builder
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y json-c-devel pkg-config && dnf clean all

WORKDIR /tmp/csi-v3
COPY v3-flexible .

RUN mkdir -p build && cd build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake .. && make && make install && ldconfig && \
    echo "✅ libcsi_logging_v3.a built and installed"

# Verify library was created
RUN test -f /usr/local/lib/libcsi_logging_v3.a || (echo "❌ libcsi_logging_v3.a not found" && exit 1)
RUN test -f /usr/local/include/csi_rb_logging_v3.h || (echo "❌ csi_rb_logging_v3.h not found" && exit 1)

# ============================================================================
# STAGE 2: Build OAI with CSI v3 integration (V2-inspired methodology)
# ============================================================================
FROM ran-base:latest AS ran-build-csi
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

# Install build dependencies (including json-c-devel for link-time)
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y json-c-devel pkg-config && dnf clean all

# Copy prebuilt CSI v3 library from stage 1
COPY --from=csi-v3-builder /usr/local/lib/libcsi_logging_v3.a /usr/local/lib/
COPY --from=csi-v3-builder /usr/local/include/csi_rb_logging_v3.h /usr/local/include/

# Verify library was copied
RUN test -f /usr/local/lib/libcsi_logging_v3.a || (echo "❌ libcsi_logging_v3.a not copied" && exit 1)

# Copy OAI source
RUN rm -Rf /oai-ran
WORKDIR /oai-ran
COPY . .

# ============================================================================
# STEP 1: Copy CSI v3 support files (V2 methodology - all sources together)
# ============================================================================
# Create dedicated CSI v3 directory in OAI (inspired by V2 patch-scripts)
RUN mkdir -p openair1/PHY/NR_ESTIMATION/csi_v3_support && \
    cp v3-flexible/src/csi_integration_v3.c openair1/PHY/NR_ESTIMATION/csi_v3_support/ && \
    cp v3-flexible/src/csi_logging_callback_v3.c openair1/PHY/NR_ESTIMATION/csi_v3_support/ && \
    cp v3-flexible/src/csi_config_parser.c openair1/PHY/NR_ESTIMATION/csi_v3_support/ && \
    cp v3-flexible/include/csi_rb_logging_v3.h openair1/PHY/NR_ESTIMATION/csi_v3_support/ && \
    echo "✅ CSI v3 sources copied to csi_v3_support/"

# Verify all files copied
RUN test -f openair1/PHY/NR_ESTIMATION/csi_v3_support/csi_integration_v3.c && \
    test -f openair1/PHY/NR_ESTIMATION/csi_v3_support/csi_logging_callback_v3.c && \
    test -f openair1/PHY/NR_ESTIMATION/csi_v3_support/csi_config_parser.c && \
    test -f openair1/PHY/NR_ESTIMATION/csi_v3_support/csi_rb_logging_v3.h || \
    (echo "❌ CSI v3 source files not copied" && exit 1)

# ============================================================================
# STEP 2: Apply CSI v3 patches (V2 methodology - textual anchors + verify)
# ============================================================================
RUN export OAI_DIR=/oai-ran && \
    chmod +x patch_srs_ul_v3.sh && \
    bash patch_srs_ul_v3.sh && \
    grep -q "nr_srs_csi_logging_invoke_v3" /oai-ran/openair1/SCHED_NR/phy_procedures_nr_gNB.c || \
    (echo "❌ PATCH VERIFICATION FAILED: nr_srs_csi_logging_invoke_v3 not found" && exit 1) && \
    echo "✅ CSI v3 patches applied and verified"

# ============================================================================
# STEP 3: Update CMakeLists.txt (V2 methodology - textual anchors + verify)
# ============================================================================
# Use sed to add CSI v3 sources to CMakeLists.txt
# Find the line with nr_ul_channel_estimation.c and add our sources after it
RUN sed -i '/\${OPENAIR1_DIR}\/PHY\/NR_ESTIMATION\/nr_ul_channel_estimation\.c/a\
  ${OPENAIR1_DIR}/PHY/NR_ESTIMATION/csi_v3_support/csi_integration_v3.c\
  ${OPENAIR1_DIR}/PHY/NR_ESTIMATION/csi_v3_support/csi_logging_callback_v3.c\
  ${OPENAIR1_DIR}/PHY/NR_ESTIMATION/csi_v3_support/csi_config_parser.c' \
    CMakeLists.txt && \
    grep -q "csi_integration_v3.c" CMakeLists.txt && \
    grep -q "csi_logging_callback_v3.c" CMakeLists.txt && \
    grep -q "csi_config_parser.c" CMakeLists.txt || \
    (echo "❌ CMakeLists.txt UPDATE FAILED: CSI v3 sources not found in CMakeLists.txt" && exit 1) && \
    echo "✅ CSI v3 sources added to CMakeLists.txt and verified"

# ============================================================================
# STEP 4: Add explicit CSI v3 linking configuration (V2 methodology)
# ============================================================================
# Create a small cmake fragment to link CSI v3 library and json-c
# This is appended to CMakeLists.txt for explicit control
RUN cat >> CMakeLists.txt << 'CMAKELISTS_CSI'

# ============= CSI v3 LOGGING INTEGRATION =============
# Link prebuilt CSI v3 library and json-c
find_package(PkgConfig REQUIRED)
pkg_check_modules(JSON_C json-c)

if(JSON_C_FOUND)
  include_directories(${JSON_C_INCLUDE_DIRS})
  # Link json-c to nr-softmodem
  set_property(TARGET nr-softmodem APPEND_STRING PROPERTY LINK_FLAGS " ${JSON_C_LDFLAGS}")
  message(STATUS "✅ json-c library found and linked")
else()
  message(FATAL_ERROR "❌ json-c library not found!")
endif()

# Link CSI v3 prebuilt library
if(EXISTS /usr/local/lib/libcsi_logging_v3.a)
  target_link_libraries(nr-softmodem /usr/local/lib/libcsi_logging_v3.a)
  message(STATUS "✅ CSI v3 library linked to nr-softmodem")
else()
  message(FATAL_ERROR "❌ libcsi_logging_v3.a not found!")
endif()

# ======================================================
CMAKELISTS_CSI

# Verify CMakeLists.txt was updated
RUN grep -q "CSI v3 LOGGING INTEGRATION" CMakeLists.txt || \
    (echo "❌ CSI v3 linking config not appended to CMakeLists.txt" && exit 1) && \
    echo "✅ CSI v3 linking configuration added and verified"

# ============================================================================
# STEP 5: Build OAI with CSI v3 support
# ============================================================================
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y gcc-toolset-13 gcc-toolset-13-gcc-c++ gcc-toolset-13-binutils && \
    /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    source /opt/rh/gcc-toolset-13/enable && \
    CXXFLAGS='-Werror=format -fstack-protector-strong' \
    CFLAGS='-Werror=format -fstack-protector-strong' \
    ./build_oai -c --ninja --eNB --gNB --RU --UE --nrUE --build-e2 \
      --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
      --cmake-opt -DKPM_VERSION=$KPM_VERSION \
      --cmake-opt '-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --cmake-opt '-DCMAKE_EXE_LINKER_FLAGS=-Wl,-z,noexecstack' \
      --build-lib 'telnetsrv enbscope uescope nrscope' \
      --build-tool-opt -k10 -w USRP -t Ethernet --noavx512 && \
    echo "✅ OAI build with CSI v3 SUCCESSFUL"

# Verify nr-softmodem was built
RUN test -f /oai-ran/cmake_targets/ran_build/build/nr-softmodem || \
    (echo "❌ nr-softmodem binary not found!" && exit 1) && \
    echo "✅ nr-softmodem binary verified"

# ============================================================================
# STEP 6: Build FlexRIC
# ============================================================================
RUN mkdir -p openair2/E2AP/flexric/build && \
    cd openair2/E2AP/flexric/build && \
    source /opt/rh/gcc-toolset-13/enable && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DKPM_VERSION=$KPM_VERSION -DE2AP_VERSION=$E2AP_VERSION .. && \
    ninja && ninja install && \
    echo "✅ FlexRIC build SUCCESSFUL"